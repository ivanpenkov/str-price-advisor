# ==============================================================================
# STR Price Advisor — Environment Variables Template
# ==============================================================================
# Copy this file to .env and fill in your actual credentials:
#   cp .env.example .env
#
# WARNING: NEVER commit the actual .env file or real credentials to Git!
# The .env file is gitignored by default.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. NordVPN SOCKS5 Proxy Credentials
# ------------------------------------------------------------------------------
# Required for OTA scraping (Airbnb, VRBO, Booking.com) via out-of-state proxy fleet.
# Obtain service credentials from your NordVPN Account Dashboard -> Services -> NordVPN -> Manual Setup.
# Note: These are separate from your NordVPN account login email/password.
NORDVPN_USER=your_nordvpn_service_username_here
NORDVPN_PASS=your_nordvpn_service_password_here
NORDVPN_SERVER=us8245.nordvpn.com:89

# ------------------------------------------------------------------------------
# 2. Streamline OwnerX / Kivoya PMS Credentials
# ------------------------------------------------------------------------------
# Required for syncing reservations and calendar blocks directly from Kivoya's PMS.
# These are your login credentials for the OwnerX portal (https://ownerx.streamlinevrs.com).
STREAMLINE_OWNER_USERNAME=your_ownerx_login_email@example.com
STREAMLINE_OWNER_PASSWORD=your_ownerx_secure_password_here

# ------------------------------------------------------------------------------
# 3. Optional Settings & Overrides (Development / Testing)
# ------------------------------------------------------------------------------
# Proxy startup delay in seconds (default: 0.6; set to 0.0 for zero-delay unit tests)
# STEALTH_STARTUP_DELAY=0.6

# Mobile notification push topic (ntfy.sh topic for alert bridge)
# NTFY_TOPIC=ivan-str-advisor-xyz

